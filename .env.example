# 复制本文件为 .env，填入真实值。.env 已在 .gitignore 中，不会被提交。
#
# AMAP_JS_KEY：高德 Web端(JS API) Key。浏览器运行时必须可见，但不要写进源码仓库。
AMAP_JS_KEY=

# AMAP_JSCODE：高德"安全密钥"，与 js/config.js 里的 amapKey 配对使用。
#   - 本地开发：填 twm_api_dev 配套那把 jscode
#   - Zeabur 部署：在 Zeabur 控制台 -> 环境变量里填 twm_api 配套那把 jscode（不要写进这里）
AMAP_JSCODE=

# AMAP_WEB_SERVICE_KEY：高德 Web 服务 Key，服务端代理 /_AMapService/* 时使用。
#   - 与 AMAP_JS_KEY/JSCODE 不同，这是服务端专用的 Key 类型。
#   - 申请地址：https://lbs.amap.com/api/webservice/guide/create-key/get
AMAP_WEB_SERVICE_KEY=

# DEEPSEEK_API_KEY：DeepSeek 平台密钥，给"AI 攻略导入"功能用
#   - 申请地址：https://platform.deepseek.com/
#   - 留空时该功能在前端 disabled，主流程不影响
DEEPSEEK_API_KEY=

# 可选：DeepSeek 模型名称。默认 deepseek-chat。
# 可选值：deepseek-chat, deepseek-reasoner 等，详见 https://platform.deepseek.com/api-docs/
# DEEPSEEK_MODEL=deepseek-chat

# 可选：DeepSeek 单次请求超时，单位毫秒。Zeabur 等部署环境链路可能比本地慢。
# 默认 90000，即 90 秒。
# DEEPSEEK_TIMEOUT_MS=90000

# 可选：BFF 监听端口，默认 8080。Zeabur 会自动注入 PORT。
# PORT=8080

# ─── RAG 配置 ───────────────────────────────────────────
# RAG_ENABLED：设为 false 可完全关闭 RAG 检索功能，不影响 AI 导入主流程。
# 默认 true。
# RAG_ENABLED=true

# 评测期间禁止把测试输入写回检索库；本地默认 true。
# RAG_SAVE_IMPORTED_GUIDES=false

# Zeabur 公网口令演示：必须使用 HTTPS、单实例，且 RAG_ENABLED=false。
# 演示模式缺少口令或开启 RAG 时拒绝启动；AI 全局 12 次解析/小时/进程。
# DEMO_MODE=true
# DEMO_USERNAME=
# DEMO_PASSWORD=

# RAG_DB_PATH：SQLite 数据库文件路径，默认为项目根目录下 data/rag.db。
# RAG_DB_PATH=

# RAG_TOP_K：检索时返回的相似攻略数量，默认 3。
# RAG_TOP_K=3

# RAG_MAX_CONTEXT_CHARS：注入 prompt 的检索上下文最大字符数，默认 1500。
# RAG_MAX_CONTEXT_CHARS=1500

# RAG_MIN_DOCS：启用检索的最低文档数（冷启动保护），默认 3。
# RAG_MIN_DOCS=3

# RAG_SEARCH_RATE_LIMIT：/_rag/search 端点每小时限流次数，默认 20。
# RAG_SEARCH_RATE_LIMIT=20
