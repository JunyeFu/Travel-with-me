{
  "name": "trip-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "lint": "node scripts/run-active-2d-quality.mjs lint",
    "format": "node scripts/run-active-2d-quality.mjs format",
    "format:check": "node scripts/run-active-2d-quality.mjs format-check",
    "check": "npm run format:check && npm run lint && npm run check:architecture && npm run check:encoding",
    "check:architecture": "node scripts/audit-render-imports.mjs && node scripts/check-2d-runtime-boundary.mjs",
    "check:encoding": "node scripts/check-visible-text-encoding.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e-smoke.mjs",
    "test:e2e:live-provider": "node scripts/run-live-provider-smoke.mjs",
    "test:live:deepseek": "node scripts/run-live-deepseek-smoke.mjs",
    "test:guide-import": "node scripts/evaluate-guide-import.mjs",
    "test:guide-import:live": "node scripts/evaluate-live-guide-import.mjs",
    "release:evidence:check": "node scripts/check-release-evidence.mjs",
    "release:review": "node scripts/create-release-review.mjs",
    "release:review:serve": "node scripts/serve-release-review.mjs",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@node-rs/jieba": "^2.0.0",
    "better-sqlite3": "^11.0.0",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.0",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.7.4",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.css": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
